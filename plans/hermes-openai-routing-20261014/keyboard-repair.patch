diff --git a/tests/tools/test_mcp_oauth_agent_input.py b/tests/tools/test_mcp_oauth_agent_input.py
new file mode 100644
index 0000000000..24b6675e77
--- /dev/null
+++ b/tests/tools/test_mcp_oauth_agent_input.py
@@ -0,0 +1,72 @@
+"""Agent startup must never compete with the composer for terminal input."""
+import asyncio
+from unittest.mock import Mock
+
+import pytest
+
+from hermes_cli import mcp_startup
+from tools import mcp_oauth
+
+
+def test_background_discovery_cannot_open_login_browser(monkeypatch, capsys):
+    monkeypatch.setattr(mcp_startup, "_mcp_discovery_started", True)
+    browser = Mock()
+    monkeypatch.setattr(mcp_oauth.webbrowser, "open", browser)
+    with pytest.raises(mcp_oauth.OAuthNonInteractiveError, match="hermes mcp login"):
+        asyncio.run(mcp_oauth._redirect_handler("https://example.test/authorize"))
+    browser.assert_not_called()
+    assert "example.test" not in capsys.readouterr().err
+
+
+def test_late_callback_cannot_start_stdin_reader(monkeypatch):
+    monkeypatch.setattr(mcp_startup, "_mcp_discovery_started", True)
+    monkeypatch.setattr(mcp_oauth, "_oauth_port", 12345)
+    server = Mock(side_effect=AssertionError("callback listener must not start"))
+    reader = Mock(side_effect=AssertionError("agent owns stdin"))
+    monkeypatch.setattr(mcp_oauth, "HTTPServer", server)
+    monkeypatch.setattr(mcp_oauth, "_paste_callback_reader", reader)
+    with pytest.raises(mcp_oauth.OAuthNonInteractiveError, match="hermes mcp login"):
+        asyncio.run(mcp_oauth._wait_for_callback())
+    server.assert_not_called()
+    reader.assert_not_called()
+
+
+def test_explicit_login_still_opens_browser(monkeypatch, capsys):
+    monkeypatch.setattr(mcp_startup, "_mcp_discovery_started", False)
+    monkeypatch.setattr(mcp_oauth, "_can_open_browser", lambda: True)
+    browser = Mock(return_value=True)
+    monkeypatch.setattr(mcp_oauth.webbrowser, "open", browser)
+    asyncio.run(mcp_oauth._redirect_handler("https://example.test/authorize"))
+    browser.assert_called_once_with("https://example.test/authorize")
+    assert "authorization required" in capsys.readouterr().err
+
+
+def test_real_background_startup_keeps_stdin_with_agent(monkeypatch):
+    import logging
+    import sys
+    import threading
+    import types
+
+    done = threading.Event()
+    errors = []
+    browser = Mock()
+    monkeypatch.setattr(mcp_startup, "_mcp_discovery_started", False)
+    monkeypatch.setattr(mcp_startup, "_mcp_discovery_thread", None)
+    monkeypatch.setattr(mcp_startup, "_has_configured_mcp_servers", lambda: True)
+    monkeypatch.setattr(mcp_oauth.webbrowser, "open", browser)
+
+    def discover():
+        try:
+            asyncio.run(mcp_oauth._redirect_handler("https://example.test/authorize"))
+        except mcp_oauth.OAuthNonInteractiveError as error:
+            errors.append(str(error))
+        finally:
+            done.set()
+
+    monkeypatch.setitem(sys.modules, "tools.mcp_tool", types.SimpleNamespace(discover_mcp_tools=discover))
+    mcp_startup.start_background_mcp_discovery(logger=logging.getLogger(__name__), thread_name="test-agent-input")
+    assert done.wait(2)
+    mcp_startup.wait_for_mcp_discovery(timeout=2)
+    assert mcp_startup.agent_owns_stdin()
+    assert len(errors) == 1 and "hermes mcp login" in errors[0]
+    browser.assert_not_called()
