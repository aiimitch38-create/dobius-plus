+      rows = this.store.listRecoverable(this.readNow(), REQUEST_LIMIT);
+    } catch {
+      return { attempted: 0, failed: 1 };
+    }
+    let attempted = 0;
+    let failed = 0;
+    for (const row of rows) {
+      try {
+        this.operations.assertNotStopping();
+      } catch {
+        break;
+      }
+      attempted += 1;
+      try {
+        await this.dispatch(row.decision_id);
+      } catch {
