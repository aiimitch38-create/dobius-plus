+        stderr,
+        `ADAM shutdown attempt failed; process and database remain owned: ${describeError(error)}\n`,
+      );
+    }
+    if (drained) return;
+    safeDiagnostic(
+      stderr,
+      `ADAM shutdown incomplete; process and database remain owned; retrying in ${retryDelayMs}ms\n`,
+    );
+    try {
+      await wait(retryDelayMs);
+    } catch (error) {
+      safeDiagnostic(
