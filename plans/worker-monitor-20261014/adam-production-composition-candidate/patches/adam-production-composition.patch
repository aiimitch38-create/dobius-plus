diff --git a/src/dobius-cloud/approved-decision-contract.ts b/src/dobius-cloud/approved-decision-contract.ts
new file mode 100644
--- /dev/null
+++ b/src/dobius-cloud/approved-decision-contract.ts
@@ -0,0 +1,57 @@
+import { z } from 'zod'
+import { canonicalCloudJobAdamJson, CLOUD_JOB_ADAM_MAX_CANONICAL_BYTES } from './receipt-contract.js'
+import { parseCanonicalApprovedJobPayload } from './approved-job-payload.js'
+
+const CloudId = z.string().regex(/^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$/)
+const Sha256 = z.string().regex(/^[a-f0-9]{64}$/)
+const SafeTime = z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER)
+
+export const TrustedApprovedCloudDecision = z.object({
+  schemaVersion: z.literal(1),
+  decisionId: z.string().uuid(),
+  actorId: CloudId,
+  actorSourceId: CloudId,
+  sourceEventId: CloudId,
+  actorEvidenceDigest: Sha256,
+  sourceBinding: Sha256,
+  authorityGeneration: z.number().int().positive().max(Number.MAX_SAFE_INTEGER),
+  parentObjectiveId: CloudId,
+  parentObjectiveVersion: z.number().int().positive().max(Number.MAX_SAFE_INTEGER),
+  projectId: CloudId,
+  contextDigest: Sha256,
+  expiresAtMs: SafeTime,
+  approvedPayloadJson: z.string().max(CLOUD_JOB_ADAM_MAX_CANONICAL_BYTES)
+}).strict()
+
+export type TrustedApprovedCloudDecision = z.infer<typeof TrustedApprovedCloudDecision>
+
+/** This provider is a trusted bootstrap dependency, never a request-body adapter. */
+export interface ApprovedCloudDecisionAuthority {
+  resolveExactDecisionJson(decisionId: string): Promise<unknown | null>
+  /** Synchronous revocation/generation fence checked after each external await. */
+  isCurrent(decision: TrustedApprovedCloudDecision): boolean
+}
+
+export function parseTrustedApprovedCloudDecision(raw: unknown, requestedDecisionId: string): TrustedApprovedCloudDecision {
+  if (typeof raw !== 'string' || Buffer.byteLength(raw, 'utf8') > 2 * CLOUD_JOB_ADAM_MAX_CANONICAL_BYTES ||
+      Buffer.from(raw, 'utf8').toString('utf8') !== raw) throw new TypeError('invalid approved decision')
+  let decoded: unknown
+  try { decoded = JSON.parse(raw) } catch { throw new TypeError('invalid approved decision') }
+  const parsed = TrustedApprovedCloudDecision.safeParse(decoded)
+  if (!parsed.success || parsed.data.decisionId !== requestedDecisionId ||
+      canonicalCloudJobAdamJson(parsed.data) !== raw) throw new TypeError('invalid approved decision')
+  const payload = parseCanonicalApprovedJobPayload(parsed.data.approvedPayloadJson)
+  if (payload.projectId !== parsed.data.projectId) throw new TypeError('invalid approved decision')
+  return parsed.data
+}
+
+export function actorSourceEvidence(decision: TrustedApprovedCloudDecision): string {
+  return canonicalCloudJobAdamJson({
+    actorId: decision.actorId,
+    actorSourceId: decision.actorSourceId,
+    sourceEventId: decision.sourceEventId,
+    actorEvidenceDigest: decision.actorEvidenceDigest,
+    sourceBinding: decision.sourceBinding,
+    authorityGeneration: decision.authorityGeneration
+  })
+}
diff --git a/src/dobius-cloud/approved-decision-publisher.ts b/src/dobius-cloud/approved-decision-publisher.ts
new file mode 100644
--- /dev/null
+++ b/src/dobius-cloud/approved-decision-publisher.ts
@@ -0,0 +1,252 @@
+import { z } from 'zod'
+import type { AdamDatabase } from '../db/database.js'
+import {
+  ApprovedDecisionStore, type ApprovedDecisionRow
+} from './approved-decision-store.js'
+import {
+  ApprovedCloudDecisionAuthority, actorSourceEvidence,
+  parseTrustedApprovedCloudDecision, type TrustedApprovedCloudDecision as Decision
+} from './approved-decision-contract.js'
+import { DobiusCloudReceiptStore } from './receipt-store.js'
+import { ApprovedJobIntentRequest, parseCanonicalApprovedJobPayload } from './approved-job-payload.js'
+import { canonicalCloudJobAdamJson } from './receipt-contract.js'
+import {
+  DobiusApprovedIntentCli, type IntentBridgeCall, type IntentBridgeCredentialAuthority, type ApprovedIntentChild
+} from './intent-bridge-cli.js'
+import { submitAdamApprovedIntent } from './child-submit.js'
+
+const DecisionId = z.string().uuid()
+const REQUEST_LIMIT = 1
+const RECOVERY_INTERVAL_MS = 15_000
+
+export type ApprovedDecisionPublisherOptions = {
+  enabled: boolean
+  database: AdamDatabase
+  receipts: DobiusCloudReceiptStore
+  decisionAuthority: ApprovedCloudDecisionAuthority
+  credentialAuthority: IntentBridgeCredentialAuthority
+  dobiusExecutablePath?: string
+  invoke?: IntentBridgeCall
+  now?: () => number
+}
+
+export type ApprovedDecisionDispatch = { decisionId: string; intentId: string; child: ApprovedIntentChild }
+
+/** Production boundary: exact decision IDs only; all authority comes from injected main-owned providers. */
+export function createApprovedDecisionPublisher(
+  options?: ApprovedDecisionPublisherOptions
+): ApprovedDecisionPublisher | undefined {
+  if (!options?.enabled || !options.database || !options.receipts || !options.decisionAuthority ||
+      !options.credentialAuthority || !options.dobiusExecutablePath) return undefined
+  try {
+    return new ApprovedDecisionPublisher(options)
+  } catch {
+    return undefined
+  }
+}
+
+export class ApprovedDecisionPublisher {
+  private readonly store: ApprovedDecisionStore
+  private readonly bridge: DobiusApprovedIntentCli
+  private readonly now: () => number
+  private readonly inflight = new Map<string, Promise<ApprovedDecisionDispatch>>()
+  private recovery: Promise<{ attempted: number; failed: number }> | undefined
+  private stopping = false
+
+  constructor(private readonly options: ApprovedDecisionPublisherOptions) {
+    if (options.enabled !== true) throw new Error('unavailable')
+    this.store = new ApprovedDecisionStore(options.database)
+    this.bridge = new DobiusApprovedIntentCli(options.dobiusExecutablePath!,
+      options.credentialAuthority, options.invoke)
+    this.now = options.now ?? Date.now
+  }
+
+  dispatch(rawDecisionId: unknown): Promise<ApprovedDecisionDispatch> {
+    const parsed = DecisionId.safeParse(rawDecisionId)
+    if (!parsed.success || this.stopping) return Promise.reject(new Error('approved decision unavailable'))
+    const id = parsed.data
+    const existing = this.inflight.get(id)
+    if (existing) return existing
+    const pending = this.dispatchOne(id).finally(() => {
+      if (this.inflight.get(id) === pending) this.inflight.delete(id)
+    })
+    this.inflight.set(id, pending)
+    return pending
+  }
+
+  recover(): Promise<{ attempted: number; failed: number }> {
+    if (this.stopping) return Promise.resolve({ attempted: 0, failed: 0 })
+    if (this.recovery) return this.recovery
+    this.recovery = this.recoverRows().finally(() => { this.recovery = undefined })
+    return this.recovery
+  }
+
+  async stop(timeoutMs = 20_000): Promise<boolean> {
+    if (!Number.isInteger(timeoutMs) || timeoutMs < 0 || timeoutMs > 60_000) return false
+    this.stopping = true
+    const pending = Promise.allSettled([
+      ...this.inflight.values(),
+      ...(this.recovery ? [this.recovery] : [])
+    ])
+    if (timeoutMs === 0) return this.inflight.size === 0 && !this.recovery
+    let timer: NodeJS.Timeout | undefined
+    const drained = await Promise.race([
+      pending.then(() => true),
+      new Promise<boolean>((resolve) => { timer = setTimeout(() => resolve(false), timeoutMs); timer.unref() })
+    ])
+    if (timer) clearTimeout(timer)
+    return drained
+  }
+
+  private async recoverRows(): Promise<{ attempted: number; failed: number }> {
+    let attempted = 0
+    let failed = 0
+    let rows: ApprovedDecisionRow[]
+    try { rows = this.store.listRecoverable(this.readNow(), REQUEST_LIMIT) }
+    catch { return { attempted, failed: 1 } }
+    for (const row of rows) {
+      attempted += 1
+      try { await this.dispatch(row.decision_id) } catch { failed += 1 }
+    }
+    return { attempted, failed }
+  }
+
+  private async dispatchOne(decisionId: string): Promise<ApprovedDecisionDispatch> {
+    const decision = await this.loadCurrentDecision(decisionId)
+    let row = this.store.persistAuthorizedDecision(decision, this.readNow())
+    this.assertRowMatches(row, decision)
+    if (row.child_json !== null) {
+      const child = parseStoredChild(row.child_json, row)
+      this.assertCurrent(decision)
+      return { decisionId, intentId: row.intent_id, child }
+    }
+    const lease = this.store.claim(decisionId, this.readNow())
+    let published = lease.row.intent_published === 1
+    try {
+      let dto = this.options.receipts.findApprovedIntentForSubmission(lease.row.intent_id)
+      if (!dto) {
+        if (published || lease.row.decision_expires_at_ms <= this.readNow()) throw new Error('approved decision unavailable')
+        const requestJson = this.store.prepareIntentRequest(decisionId, lease.token, this.readNow())
+        row = this.store.get(decisionId) ?? lease.row
+        const request = ApprovedJobIntentRequest.parse(JSON.parse(requestJson))
+        if (canonicalCloudJobAdamJson(request) !== requestJson) throw new Error('approved decision unavailable')
+        const payload = parseCanonicalApprovedJobPayload(row.approved_payload_json)
+        if (payload.projectId !== row.project_id || payload.digest !== row.approved_payload_digest) {
+          throw new Error('approved decision unavailable')
+        }
+        this.assertCurrent(decision)
+        const staged = this.store.readStagedIntent(decisionId, lease.token)
+        if (staged) {
+          this.options.receipts.publishStagedApprovedJobGrantWithIntent(
+            canonicalCloudJobAdamJson(request), staged, () => this.assertCurrent(decision)
+          )
+        } else {
+          await this.options.receipts.issueApprovedJobGrantWithIntent(
+            canonicalCloudJobAdamJson(request), async (envelope) => {
+              const sealed = await this.bridge.seal(envelope, decision, () => this.assertCurrent(decision))
+              this.assertCurrent(decision)
+              this.store.stageSealedIntent(decisionId, lease.token, envelope, sealed, this.readNow())
+              return sealed
+            }, () => this.assertCurrent(decision), row.intent_expires_at_ms
+          )
+        }
+        dto = this.options.receipts.findApprovedIntentForSubmission(row.intent_id)
+        if (!dto) throw new Error('approved decision unavailable')
+      }
+      this.assertDtoMatches(dto, row, decision)
+      if (!published) {
+        this.store.markIntentPublished(decisionId, lease.token, this.readNow())
+        published = true
+      }
+      this.assertCurrent(decision)
+      const child = await submitAdamApprovedIntent(dto, decision, this.bridge, () => this.assertCurrent(decision))
+      this.assertCurrent(decision)
+      this.store.markChildSubmitted(decisionId, lease.token, child, this.readNow())
+      return { decisionId, intentId: row.intent_id, child }
+    } catch (error) {
+      // Do not compensate or reseal; a published exact intent is the only retry input.
+      if (published) {
+        try { this.store.releasePublishedAttempt(decisionId, lease.token, this.readNow()) } catch { /* lease expires safely */ }
+      }
+      throw error
+    }
+  }
+
+  private async loadCurrentDecision(decisionId: string): Promise<Decision> {
+    const source = this.options.decisionAuthority
+    let raw: unknown
+    try { raw = await source.resolveExactDecisionJson(decisionId) } catch { throw new Error('approved decision unavailable') }
+    let decision: Decision
+    try { decision = parseTrustedApprovedCloudDecision(raw, decisionId) }
+    catch { throw new Error('approved decision unavailable') }
+    this.assertCurrent(decision)
+    const existing = this.store.get(decisionId)
+    if (existing && (existing.source_record_json !== canonicalCloudJobAdamJson(decision) ||
+        existing.actor_source_json !== actorSourceEvidence(decision) ||
+        existing.authority_generation !== decision.authorityGeneration || existing.source_binding !== decision.sourceBinding)) {
+      throw new Error('approved decision unavailable')
+    }
+    return decision
+  }
+
+  private assertRowMatches(row: ApprovedDecisionRow, decision: Decision): void {
+    if (row.source_record_json !== canonicalCloudJobAdamJson(decision) ||
+        row.actor_source_json !== actorSourceEvidence(decision) || row.decision_id !== decision.decisionId ||
+        row.project_id !== decision.projectId || row.parent_objective_id !== decision.parentObjectiveId ||
+        row.parent_objective_version !== decision.parentObjectiveVersion || row.context_digest !== decision.contextDigest ||
+        row.authority_generation !== decision.authorityGeneration || row.source_binding !== decision.sourceBinding) {
+      throw new Error('approved decision unavailable')
+    }
+  }
+
+  private assertDtoMatches(
+    dto: NonNullable<ReturnType<DobiusCloudReceiptStore['findApprovedIntentForSubmission']>>,
+    row: ApprovedDecisionRow,
+    decision: Decision
+  ): void {
+    if (dto.intentId !== row.intent_id || dto.identity.projectId !== row.project_id ||
+        dto.identity.parentObjectiveId !== row.parent_objective_id ||
+        dto.identity.parentObjectiveVersion !== row.parent_objective_version ||
+        dto.identity.contextDigest !== row.context_digest || dto.identity.adamInstanceId !== this.options.receipts.instanceId ||
+        dto.approvedJob.projectId !== row.project_id ||
+        canonicalCloudJobAdamJson(dto.approvedJob) !== row.approved_payload_json ||
+        dto.identity.requestFingerprint !== row.approved_payload_digest ||
+        dto.identity.expiresAtMs !== row.intent_expires_at_ms ||
+        dto.identity.expiresAtMs > row.decision_expires_at_ms || decision.projectId !== row.project_id) {
+      throw new Error('approved decision unavailable')
+    }
+  }
+
+  private assertCurrent(decision: Decision): void {
+    try {
+      if (!this.options.decisionAuthority.isCurrent(decision)) throw new Error('stale')
+    } catch { throw new Error('approved decision unavailable') }
+  }
+
+  private readNow(): number {
+    const value = this.now()
+    if (!Number.isSafeInteger(value) || value < 0) throw new Error('approved decision unavailable')
+    return value
+  }
+}
+
+function parseStoredChild(json: string, row: ApprovedDecisionRow): ApprovedIntentChild {
+  let value: unknown
+  try { value = JSON.parse(json) } catch { throw new Error('approved decision unavailable') }
+  const child = z.object({
+    id: z.string().regex(/^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$/),
+    state: z.enum(['queued', 'waiting_for_worker', 'running', 'needs_review', 'completed', 'failed', 'cancelled', 'interrupted']),
+    projectId: z.string(), requestKey: z.string(), taskId: z.string(), workspaceId: z.string(),
+    sourceRevision: z.string(), targetDeviceId: z.string(), recipeId: z.string()
+  }).strict().safeParse(value)
+  if (!child.success || child.data.projectId !== row.project_id) throw new Error('approved decision unavailable')
+  const payload = parseCanonicalApprovedJobPayload(row.approved_payload_json).approvedJob
+  if (child.data.requestKey !== payload.requestKey || child.data.taskId !== payload.taskId ||
+      child.data.workspaceId !== payload.workspaceId || child.data.sourceRevision !== payload.sourceRevision ||
+      child.data.targetDeviceId !== payload.targetDeviceId || child.data.recipeId !== payload.recipeId) {
+    throw new Error('approved decision unavailable')
+  }
+  return child.data
+}
+
+export const APPROVED_DECISION_RECOVERY_INTERVAL_MS = RECOVERY_INTERVAL_MS
diff --git a/src/dobius-cloud/approved-decision-store.ts b/src/dobius-cloud/approved-decision-store.ts
new file mode 100644
--- /dev/null
+++ b/src/dobius-cloud/approved-decision-store.ts
@@ -0,0 +1,258 @@
+import { createHash, randomUUID } from 'node:crypto'
+import type { AdamDatabase } from '../db/database.js'
+import { canonicalCloudJobAdamJson, canonicalCloudJobAdamSha256 } from './receipt-contract.js'
+import { ApprovedJobIntentRequest, parseCanonicalApprovedJobPayload } from './approved-job-payload.js'
+import { actorSourceEvidence, type TrustedApprovedCloudDecision } from './approved-decision-contract.js'
+import { AdamCloudIntentEnvelope, AdamCloudSealedEnvelope } from './intent-contract.js'
+import { CloudJobAdamBindingIdentity } from './receipt-contract.js'
+
+const MAX_INTENT_TTL_MS = 300_000
+const DISPATCH_LEASE_MS = 30_000
+
+export class ApprovedDecisionStoreError extends Error {
+  constructor(readonly code: 'invalid' | 'expired' | 'conflict' | 'busy' | 'missing') { super(code) }
+}
+
+export type ApprovedDecisionRow = {
+  decision_id: string
+  source_record_json: string
+  actor_source_json: string
+  authority_generation: number
+  source_binding: string
+  parent_objective_id: string
+  parent_objective_version: number
+  project_id: string
+  context_digest: string
+  approved_payload_json: string
+  approved_payload_digest: string
+  intent_id: string
+  intent_request_json: string
+  decision_expires_at_ms: number
+  intent_expires_at_ms: number
+  staged_identity_json: string | null
+  staged_sealed_envelope: string | null
+  staged_capability_hash: string | null
+  intent_published: number
+  lease_token: string | null
+  lease_until_ms: number | null
+  child_json: string | null
+  created_at_ms: number
+  updated_at_ms: number
+}
+
+export class ApprovedDecisionStore {
+  constructor(private readonly db: AdamDatabase) {}
+
+  persistAuthorizedDecision(decision: TrustedApprovedCloudDecision, now: number): ApprovedDecisionRow {
+    assertTime(now)
+    const payload = parseCanonicalApprovedJobPayload(decision.approvedPayloadJson)
+    if (payload.projectId !== decision.projectId) throw new ApprovedDecisionStoreError('conflict')
+    const sourceRecordJson = canonicalCloudJobAdamJson(decision)
+    const existing = this.get(decision.decisionId)
+    if (existing) {
+      if (existing.source_record_json !== sourceRecordJson ||
+          existing.approved_payload_json !== payload.json || existing.approved_payload_digest !== payload.digest ||
+          existing.project_id !== decision.projectId || existing.source_binding !== decision.sourceBinding ||
+          existing.authority_generation !== decision.authorityGeneration) {
+        throw new ApprovedDecisionStoreError('conflict')
+      }
+      return existing
+    }
+    if (decision.expiresAtMs - now < 1000) throw new ApprovedDecisionStoreError('expired')
+    const ttlMs = Math.min(MAX_INTENT_TTL_MS, decision.expiresAtMs - now)
+    if (ttlMs < 1000) throw new ApprovedDecisionStoreError('expired')
+    const intentExpiresAtMs = now + ttlMs
+    if (!Number.isSafeInteger(intentExpiresAtMs)) throw new ApprovedDecisionStoreError('invalid')
+    const intentId = randomUUID()
+    const request = ApprovedJobIntentRequest.parse({
+      intentId,
+      parentObjectiveId: decision.parentObjectiveId,
+      parentObjectiveVersion: decision.parentObjectiveVersion,
+      projectId: decision.projectId,
+      contextDigest: decision.contextDigest,
+      requestFingerprint: payload.digest,
+      ttlMs,
+      approvedJob: payload.approvedJob
+    })
+    return this.transaction(() => {
+      const raced = this.get(decision.decisionId)
+      if (raced) {
+        if (raced.source_record_json !== sourceRecordJson || raced.approved_payload_digest !== payload.digest) {
+          throw new ApprovedDecisionStoreError('conflict')
+        }
+        return raced
+      }
+      const parent = this.db.prepare(`SELECT j.project_id,j.state,r.revision
+        FROM jobs j JOIN dobius_parent_revisions r ON r.job_id=j.id WHERE j.id=?`)
+        .get(decision.parentObjectiveId) as { project_id: string | null; state: string; revision: number } | undefined
+      if (!parent || parent.project_id !== decision.projectId || parent.revision !== decision.parentObjectiveVersion ||
+          ['completed', 'reported', 'failed', 'cancelled'].includes(parent.state)) {
+        throw new ApprovedDecisionStoreError('conflict')
+      }
+      this.db.prepare(`INSERT INTO dobius_cloud_approved_decisions
+        (decision_id,source_record_json,actor_source_json,authority_generation,source_binding,
+         parent_objective_id,parent_objective_version,project_id,context_digest,approved_payload_json,
+         approved_payload_digest,intent_id,intent_request_json,decision_expires_at_ms,intent_expires_at_ms,intent_published,
+         created_at_ms,updated_at_ms)
+        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,0,?,?)`).run(
+        decision.decisionId, sourceRecordJson, actorSourceEvidence(decision), decision.authorityGeneration,
+        decision.sourceBinding, decision.parentObjectiveId, decision.parentObjectiveVersion, decision.projectId,
+        decision.contextDigest, payload.json, payload.digest, intentId, canonicalCloudJobAdamJson(request),
+        decision.expiresAtMs, intentExpiresAtMs, now, now
+      )
+      const inserted = this.get(decision.decisionId)
+      if (!inserted) throw new ApprovedDecisionStoreError('conflict')
+      return inserted
+    })
+  }
+
+  get(decisionId: string): ApprovedDecisionRow | undefined {
+    return this.db.prepare('SELECT * FROM dobius_cloud_approved_decisions WHERE decision_id=?').get(decisionId) as
+      ApprovedDecisionRow | undefined
+  }
+
+  listRecoverable(now: number, limit = 1): ApprovedDecisionRow[] {
+    assertTime(now)
+    if (!Number.isSafeInteger(limit) || limit < 1 || limit > 128) throw new ApprovedDecisionStoreError('invalid')
+    return this.db.prepare(`SELECT * FROM dobius_cloud_approved_decisions
+      WHERE child_json IS NULL AND (intent_published=1 OR decision_expires_at_ms>?)
+        AND (lease_until_ms IS NULL OR lease_until_ms<=?) ORDER BY created_at_ms,decision_id LIMIT ?`)
+      .all(now, now, limit) as unknown as ApprovedDecisionRow[]
+  }
+
+  claim(decisionId: string, now: number): { token: string; row: ApprovedDecisionRow } {
+    assertTime(now)
+    return this.transaction(() => {
+      const row = this.get(decisionId)
+      if (!row) throw new ApprovedDecisionStoreError('missing')
+      if (row.child_json !== null) throw new ApprovedDecisionStoreError('conflict')
+      if (!row.intent_published && row.decision_expires_at_ms <= now) throw new ApprovedDecisionStoreError('expired')
+      if (row.lease_until_ms !== null && row.lease_until_ms > now) throw new ApprovedDecisionStoreError('busy')
+      const token = randomUUID()
+      const until = now + DISPATCH_LEASE_MS
+      if (!Number.isSafeInteger(until)) throw new ApprovedDecisionStoreError('invalid')
+      const changed = this.db.prepare(`UPDATE dobius_cloud_approved_decisions SET lease_token=?,lease_until_ms=?,updated_at_ms=?
+        WHERE decision_id=? AND child_json IS NULL AND (lease_until_ms IS NULL OR lease_until_ms<=?)`)
+        .run(token, until, now, decisionId, now)
+      if (Number(changed.changes) !== 1) throw new ApprovedDecisionStoreError('busy')
+      return { token, row: { ...row, lease_token: token, lease_until_ms: until } }
+    })
+  }
+
+  prepareIntentRequest(decisionId: string, token: string, now: number): string {
+    assertTime(now)
+    return this.transaction(() => {
+      const row = this.get(decisionId)
+      if (!row || row.lease_token !== token || row.intent_published || row.child_json !== null) {
+        throw new ApprovedDecisionStoreError('conflict')
+      }
+      const ttlMs = row.intent_expires_at_ms - now
