+"""An embedded gateway may isolate transcripts without pruning its host profile."""
+
+from unittest.mock import MagicMock, patch
+
+from gateway.config import GatewayConfig
+
+
+def test_supplied_database_is_used_without_global_maintenance(tmp_path):
+    from gateway.run import GatewayRunner
+
+    scoped_db = MagicMock()
+    config = GatewayConfig(sessions_dir=tmp_path / "sessions")
+    with (
+        patch(
+            "hermes_state.SessionDB",
+            side_effect=AssertionError("must not open default profile DB"),
+        ),
+        patch(
+            "hermes_cli.config.load_config",
+            return_value={
+                "sessions": {"auto_prune": True},
+                "checkpoints": {"auto_prune": True},
+            },
+        ),
+        patch(
+            "tools.checkpoint_manager.maybe_auto_prune_checkpoints"
+        ) as checkpoint_prune,
+        patch("gateway.pairing.PairingStore"),
+    ):
+        runner = GatewayRunner(config, session_db=scoped_db, perform_maintenance=False)
+    assert runner._session_db is scoped_db
+    assert runner.session_store._db is scoped_db
+    scoped_db.maybe_auto_prune_and_vacuum.assert_not_called()
+    checkpoint_prune.assert_not_called()
+
+
+def test_default_gateway_still_opens_default_db_and_runs_opted_in_maintenance(tmp_path):
+    from gateway.run import GatewayRunner
+
+    database = MagicMock()
+    config = GatewayConfig(sessions_dir=tmp_path / "sessions")
+    with (
+        patch("hermes_state.SessionDB", return_value=database) as default_db,
+        patch(
+            "hermes_cli.config.load_config",
+            return_value={
+                "sessions": {"auto_prune": True},
+                "checkpoints": {"auto_prune": True},
+            },
+        ),
+        patch(
+            "tools.checkpoint_manager.maybe_auto_prune_checkpoints"
+        ) as checkpoint_prune,
+        patch("gateway.pairing.PairingStore"),
+    ):
+        runner = GatewayRunner(config)
+    assert runner._session_db is database
+    assert default_db.call_count == 2  # Legacy runner and transcript store.
+    assert all(
+        call.args == () and call.kwargs == {} for call in default_db.call_args_list
+    )
+    database.maybe_auto_prune_and_vacuum.assert_called_once()
+    checkpoint_prune.assert_called_once()
