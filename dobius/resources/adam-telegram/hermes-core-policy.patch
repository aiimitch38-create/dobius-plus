diff --git a/agent/host_tool_policy.py b/agent/host_tool_policy.py
new file mode 100644
index 0000000000..9a19cc59a3
--- /dev/null
+++ b/agent/host_tool_policy.py
@@ -0,0 +1,134 @@
+"""Host-owned execution restrictions, independent of model/config tool selection.
+
+Platform adapters bind a policy before creating agents. Bindings cannot be
+relaxed for the lifetime of the process; agent initialization snapshots the
+frozen value. This is a tool boundary, not a sandbox for trusted Python plugins.
+"""
+
+from dataclasses import dataclass
+import json
+import threading
+
+
+@dataclass(frozen=True)
+class ToolExecutionPolicy:
+    name: str
+    allowed_tool_names: frozenset[str] | None
+
+    def allows(self, name: str) -> bool:
+        return self.allowed_tool_names is None or name in self.allowed_tool_names
+
+
+UNRESTRICTED_POLICY = ToolExecutionPolicy("unrestricted", None)
+NO_TOOLS_POLICY = ToolExecutionPolicy("no-tools", frozenset())
+_POLICIES = {p.name: p for p in (UNRESTRICTED_POLICY, NO_TOOLS_POLICY)}
+_platform_policies: dict[str, ToolExecutionPolicy] = {}
+_policy_lock = threading.Lock()
+
+
+def require_platform_tool_policy(platform: str, policy: ToolExecutionPolicy) -> None:
+    """Install a trusted binding; repeated identical bindings are harmless."""
+    if (
+        not isinstance(platform, str)
+        or not platform
+        or not isinstance(policy, ToolExecutionPolicy)
+        or policy not in _POLICIES.values()
+    ):
+        raise ValueError("Invalid host tool policy binding")
+    # Store our canonical deeply immutable value, even if an external caller
+    # supplied an equal dataclass whose collection was mutable at runtime.
+    policy = _POLICIES[policy.name]
+    with _policy_lock:
+        current = _platform_policies.get(platform)
+        if current is not None and current != policy:
+            raise ValueError("Host tool policy binding cannot be changed")
+        _platform_policies[platform] = policy
+
+
+def policy_for_platform(platform: str | None) -> ToolExecutionPolicy:
+    return _platform_policies.get(platform, UNRESTRICTED_POLICY)
+
+
+def policy_for_agent(agent) -> ToolExecutionPolicy:
+    # Legacy lightweight test agents need no initialization changes.
+    policy = getattr(agent, "_host_tool_policy", None)
+    if not isinstance(policy, ToolExecutionPolicy):
+        policy = policy_for_platform(getattr(agent, "platform", None))
+    return policy
+
+
+def blocked_tool_result(agent, name: str) -> str | None:
+    if policy_for_agent(agent).allows(name):
+        return None
+    return json.dumps({
+        "error": "Tool execution is disabled by host policy",
+        "status": "blocked",
+        "code": "host_tool_policy",
+    })
+
+
+def filter_agent_tools(agent) -> None:
+    """Apply after plugin, MCP, memory, and context-engine schema injection."""
+    policy = policy_for_agent(agent)
+    if policy.allowed_tool_names is None:
+        return
+    agent.tools = [
+        tool
+        for tool in (agent.tools or [])
+        if policy.allows(tool.get("function", {}).get("name", ""))
+    ]
+    agent.valid_tool_names = {tool["function"]["name"] for tool in agent.tools}
+    agent._context_engine_tool_names = (
+        set(getattr(agent, "_context_engine_tool_names", set()))
+        & agent.valid_tool_names
+    )
+
+
+def enforce_request_policy(agent, kwargs: dict) -> dict:
+    """Last boundary after request middleware, including provider-native tools."""
+    if policy_for_agent(agent) == NO_TOOLS_POLICY:
+        kwargs = dict(kwargs)
+        kwargs.pop("tools", None)
+        kwargs.pop("tool_choice", None)
+        kwargs.pop("parallel_tool_calls", None)
+        kwargs.pop("functions", None)
+        kwargs.pop("function_call", None)
+    return kwargs
+
+
+def validate_runtime_policy(agent) -> None:
+    """Opaque agent runtimes execute their own tools, outside this boundary."""
+    if policy_for_agent(agent) != NO_TOOLS_POLICY:
+        return
+    mode = getattr(agent, "api_mode", "")
+    provider = getattr(agent, "provider", "")
+    base_url = str(getattr(agent, "base_url", "") or "").lower()
+    if (
+        mode
+        not in {
+            "chat_completions",
+            "codex_responses",
+            "anthropic_messages",
+            "bedrock_converse",
+        }
+        or provider == "copilot-acp"
+        or base_url.startswith(("acp://", "acp+tcp://"))
+    ):
+        raise ValueError("Host tool policy requires a host-controlled model transport")
+
+
+def reject_tool_batch(agent, assistant_message, messages: list) -> bool:
+    """Deny before tool middleware, hooks, checkpoints, callbacks, or dispatch."""
+    if policy_for_agent(agent) != NO_TOOLS_POLICY:
+        return False
+    from agent.tool_dispatch_helpers import make_tool_result_message
+
+    for call in assistant_message.tool_calls:
+        messages.append(
+            make_tool_result_message(
+                call.function.name,
+                blocked_tool_result(agent, call.function.name),
+                call.id,
+            )
+        )
+    return True
diff --git a/tests/run_agent/test_host_tool_policy.py b/tests/run_agent/test_host_tool_policy.py
new file mode 100644
index 0000000000..bca75db1c4
--- /dev/null
+++ b/tests/run_agent/test_host_tool_policy.py
@@ -0,0 +1,406 @@
+"""Host restrictions survive tool injection, config changes, and model calls."""
+
+from dataclasses import FrozenInstanceError
+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+from uuid import uuid4
+
+import pytest
+
+from agent.host_tool_policy import (
+    NO_TOOLS_POLICY,
+    UNRESTRICTED_POLICY,
+    enforce_request_policy,
+    filter_agent_tools,
+    policy_for_platform,
+    require_platform_tool_policy,
+    validate_runtime_policy,
+)
+from gateway.platform_registry import PlatformEntry, PlatformRegistry
+from run_agent import AIAgent
+
+
+def schema(name):
+    return {
+        "type": "function",
+        "function": {
+            "name": name,
+            "description": name,
+            "parameters": {"type": "object", "properties": {}},
+        },
+    }
+
+
+def restricted_agent():
+    return SimpleNamespace(_host_tool_policy=NO_TOOLS_POLICY)
+
+
+def call(name, arguments="{}", call_id="call-1"):
+    return SimpleNamespace(
+        id=call_id, function=SimpleNamespace(name=name, arguments=arguments)
+    )
+
+
+def make_agent(platform=None, skip_memory=True):
+    with (
+        patch(
+            "run_agent.get_tool_definitions",
+            return_value=[
+                schema("terminal"),
+                schema("mcp_private"),
+                schema("plugin_tool"),
+            ],
+        ),
+        patch("run_agent.check_toolset_requirements", return_value={}),
+        patch("run_agent.OpenAI"),
+    ):
+        return AIAgent(
+            api_key="synthetic-test-key",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            platform=platform,
+            skip_context_files=True,
+            skip_memory=skip_memory,
+        )
+
+
+def test_registered_platform_policy_applies_to_real_agent_despite_enabled_tools():
+    name = "restricted_" + uuid4().hex
+    registry = PlatformRegistry()
+    registry.register(
+        PlatformEntry(
+            name=name,
+            label="Restricted",
+            adapter_factory=lambda cfg: cfg,
+            check_fn=lambda: True,
+            tool_execution_policy="no-tools",
+        )
+    )
+    agent = make_agent(name)
+    assert agent.host_tool_policy == NO_TOOLS_POLICY
+    assert agent.tools == []
+    assert agent.valid_tool_names == set()
+    # A later config/platform mutation cannot loosen this agent's snapshot.
+    agent.platform = "cli"
+    agent.enabled_toolsets = ["all"]
+    assert (
+        json.loads(agent._invoke_tool("terminal", {}, "task"))["code"]
+        == "host_tool_policy"
+    )
+    with pytest.raises(FrozenInstanceError):
+        agent.host_tool_policy.name = "unrestricted"
+    with pytest.raises(AttributeError):
+        agent.host_tool_policy = UNRESTRICTED_POLICY
+
+
+def test_binding_and_platform_reregistration_cannot_relax_restriction():
+    name = "bound_" + uuid4().hex
+    require_platform_tool_policy(name, NO_TOOLS_POLICY)
+    require_platform_tool_policy(name, NO_TOOLS_POLICY)
+    with pytest.raises(ValueError):
+        require_platform_tool_policy(name, UNRESTRICTED_POLICY)
+    with pytest.raises(ValueError):
+        PlatformRegistry().register(
+            PlatformEntry(
+                name=name,
+                label=name,
+                adapter_factory=lambda cfg: cfg,
+                check_fn=lambda: True,
+            )
+        )
+    assert policy_for_platform(name) == NO_TOOLS_POLICY
+
+
+def test_invalid_policy_fails_closed_in_registration():
+    with pytest.raises(ValueError):
+        PlatformRegistry().register(
+            PlatformEntry(
+                name="invalid_policy",
+                label="Invalid",
+                adapter_factory=lambda cfg: cfg,
+                check_fn=lambda: True,
+                tool_execution_policy="none-typo",
+            )
+        )
+
+
+def test_all_late_injected_schemas_are_filtered_without_changing_memory_context():
+    agent = restricted_agent()
+    agent.tools = [
+        schema(name)
+        for name in (
+            "memory",
+            "lcm_grep",
+            "mcp_private",
+            "plugin_tool",
+            "tool_call",
+            "delegate_task",
+        )
+    ]
+    agent.valid_tool_names = {s["function"]["name"] for s in agent.tools}
+    agent._context_engine_tool_names = {"lcm_grep"}
+    agent._memory_store = {"MEMORY.md": "Adam's trusted identity"}
+    memory = agent._memory_store
+    filter_agent_tools(agent)
+    assert agent.tools == []
+    assert agent.valid_tool_names == set()
+    assert agent._context_engine_tool_names == set()
+    assert agent._memory_store is memory
+
+
+def test_real_initialization_keeps_profile_memory_readable_but_not_writable():
+    from tools.memory_tool import get_memory_dir
+
+    directory = get_memory_dir()
+    directory.mkdir(parents=True, exist_ok=True)
+    memory_path = directory / "MEMORY.md"
+    memory_path.write_text("Adam coordinates Carson's projects.", encoding="utf-8")
+    name = "memory_" + uuid4().hex
+    require_platform_tool_policy(name, NO_TOOLS_POLICY)
+    with patch(
+        "hermes_cli.config.load_config",
+        return_value={"memory": {"memory_enabled": True, "user_profile_enabled": True}},
+    ):
+        agent = make_agent(name, skip_memory=False)
+    assert agent._memory_store is not None
