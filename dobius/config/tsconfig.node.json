{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "../electron.vite.config.*",
    "../src/main/**/*",
    "../src/preload/**/*",
    "../src/shared/**/*",
    "../src/relay/**/*",
    "../src/types/**/*"
  ],
  // Why excluded here: the verify/ suite drives production code directly and
  // reaches files outside this project's file list, which TS reports as
  // TS6307 rather than silently resolving. verify/ has its own
  // src/main/communications/verify/tsconfig.json (DOM lib for its
  // browser-like harness surfaces) — typecheck it with:
  //   npx tsc --noEmit -p src/main/communications/verify/tsconfig.json
  "exclude": ["../src/main/communications/verify/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
