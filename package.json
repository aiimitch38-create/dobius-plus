{
  "name": "dobius-plus",
  "version": "1.0.61",
  "description": "Multi-window Claude Code desktop app with themed terminals",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.js",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && vite build --config vite.mobile.config.js && electron-builder --mac",
    "start": "electron .",
    "test:fresh": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/fresh-session.test.mjs",
    "test:argv": "node ./electron/__tests__/claude-argv.test.mjs",
    "test": "npm run test:argv && npm run test:fresh && npm run test:preview && npm run test:gws && npm run test:shim && npm run test:status && npm run test:conn && npm run test:selector && npm run test:modellabel && npm run test:checkpoints && npm run test:gitgraph && npm run test:filemanager && npm run test:queued && npm run test:ctxwindow && npm run test:tearoff && npm run test:clive && npm run test:contsess && npm run test:commitlog && npm run test:ptyshutdown && npm run test:looseends && npm run test:boardorder && npm run test:livesess && npm run test:loosedismiss && npm run test:termfont && npm run test:tailread",
    "test:preview": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/preview-sanitize.test.mjs",
    "test:gws": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/gws-accounts.test.mjs",
    "test:shim": "node ./electron/__tests__/gws-shim.test.mjs",
    "test:status": "node ./electron/__tests__/terminal-status.test.mjs",
    "test:conn": "node ./electron/__tests__/connection.test.mjs",
    "test:selector": "node ./electron/__tests__/selector-parser.test.mjs",
    "test:modellabel": "node ./electron/__tests__/model-label.test.mjs",
    "test:checkpoints": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/checkpoint-migration.test.mjs",
    "test:tearoff": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/tearoff-tabs.test.mjs",
    "lint": "eslint electron src mobile shared",
    "test:gitgraph": "node ./electron/__tests__/git-graph.test.mjs",
    "test:filemanager": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/file-manager.test.mjs",
    "test:queued": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/queued-messages.test.mjs",
    "test:ctxwindow": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/context-window.test.mjs",
    "test:clive": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/claude-live.test.mjs",
    "test:contsess": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/continued-session.test.mjs",
    "test:commitlog": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/commit-log.test.mjs",
    "test:ptyshutdown": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/pty-shutdown.test.mjs",
    "test:looseends": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/loose-ends.test.mjs",
    "test:boardorder": "node ./electron/__tests__/board-order.test.mjs",
    "test:livesess": "node --import ./electron/__tests__/register.mjs ./electron/__tests__/live-sessions.test.mjs",
    "test:loosedismiss": "node ./electron/__tests__/loose-dismiss.test.mjs",
    "test:termfont": "node ./electron/__tests__/terminal-font.test.mjs",
    "test:tailread": "node ./electron/__tests__/tail-read.test.mjs"
  },
  "keywords": [],
  "author": "Status Digital Marketing",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statusdigitalmarketing/dobius-plus.git"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "framer-motion": "^12.34.3",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.20.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
